# Server-only values. Copy into .env.local; never commit real credentials.
OPENAI_API_KEY=
OPENSEA_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# A separate random secret of at least 32 characters; stable across deployments.
ROAST_RATE_LIMIT_SECRET=
ROASTS_ENABLED=true
ROAST_COOLDOWN_SECONDS=20
ROAST_HOURLY_LIMIT=8
ROAST_DAILY_LIMIT=20
ROAST_GLOBAL_DAILY_LIMIT=200

# Vercel Marketplace alternative: use this pair OR the UPSTASH pair above.
# The integration supplies these automatically; do not use the read-only token.
KV_REST_API_URL=
KV_REST_API_TOKEN=
